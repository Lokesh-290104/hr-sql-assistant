# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest

# MySQL. Root password = the one you set in MySQL Configurator.
# App password = any NEW password; setup creates a read-only user with it.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hr_assistant
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=hr_readonly
MYSQL_APP_PASSWORD=

# Leave MYSQL_APP_PASSWORD empty (and DATABASE_URL unset) to use a local SQLite
# demo DB instead (create it with: python -m scripts.seed).
# Or set a full SQLAlchemy URL directly; it overrides the MYSQL_* values:
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/hr_assistant
# ADMIN_DATABASE_URL=   (used by scripts.seed; needs write access)

# Guardrails
MAX_ROWS=200
QUERY_TIMEOUT_MS=5000
MAX_REPAIR_ATTEMPTS=2
HISTORY_TURNS=3
LLM_TIMEOUT_MS=30000
LLM_DEADLINE_MS=60000
RESTRICTED_TABLES=salaries
